# Option A (recommended): keep everything in config.json (see config.example.json)
# and manage it from the Telegram admin panel (/admin).
#
# Option B: export these (not auto-loaded from .env). They fill in only the
# keys missing from config.json:
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_ADMIN_ID=your_numeric_telegram_user_id
TELEGRAM_CHAT_ID=chat_id_that_receives_alerts
# CHECK_INTERVAL=900
# MAX_PAGES=5
# HTTPS_PROXY=http://127.0.0.1:8080
